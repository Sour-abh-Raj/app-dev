rules_version = '2';

// Progress photos are private: owner-only, JPEG only, ≤10 MB. Nothing is public.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function okImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    match /progress-photos/{uid}/{checkinId}/{file} {
      allow read: if isOwner(uid);
      // Clients write only the original; _thumb/_1024 variants come from a Function.
      allow create, update: if isOwner(uid) && okImage()
        && file.matches('^(front|side|back)\\.jpg$');
      allow delete: if isOwner(uid);
    }

    match /meals/{uid}/{file} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && okImage();
      allow delete: if isOwner(uid);
    }

    match /previews/_placeholder/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /previews/{uid}/{file=**} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
